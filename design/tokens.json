{
  "color": {
    "paper": "#F7F4EE",
    "surface": "#FDFCFA",
    "surface-raised": "#FFFFFF",
    "ink": "#1A1B1E",
    "ink-soft": "#3E4348",
    "ink-mute": "#6B7280",
    "line": "#E3DED3",
    "line-strong": "#C9C2B2",
    "brand": "#2F5D50",
    "brand-deep": "#24483E",
    "brand-tint": "#E4EDE8",
    "amber": "#C98A2C",
    "terracotta": "#B4552D",
    "success": "#3E7C59",
    "warning": "#B97A1F",
    "danger": "#B3402E",
    "info": "#4A6D8C"
  },
  "semantic": {
    "text-primary": "color.ink",
    "text-secondary": "color.ink-soft",
    "text-tertiary": "color.ink-mute",
    "bg-base": "color.paper",
    "bg-panel": "color.surface",
    "bg-elevated": "color.surface-raised",
    "border-subtle": "color.line",
    "border-strong": "color.line-strong",
    "interactive": "color.brand",
    "interactive-hover": "color.brand-deep",
    "interactive-bg": "color.brand-tint",
    "accent-highlight": "color.amber",
    "accent-media": "color.terracotta"
  },
  "font": {
    "family-serif": "'Noto Serif SC', Georgia, serif",
    "family-sans": "'Noto Sans SC', system-ui, sans-serif",
    "family-mono": "'JetBrains Mono', 'SFMono-Regular', monospace"
  },
  "type": {
    "display": {
      "size": 32,
      "line-height": 40,
      "weight": 700,
      "family": "font.family-serif"
    },
    "h1": {
      "size": 28,
      "line-height": 36,
      "weight": 700,
      "family": "font.family-serif"
    },
    "h2": {
      "size": 22,
      "line-height": 30,
      "weight": 600,
      "family": "font.family-serif"
    },
    "h3": {
      "size": 18,
      "line-height": 26,
      "weight": 600,
      "family": "font.family-sans"
    },
    "h4": {
      "size": 16,
      "line-height": 24,
      "weight": 600,
      "family": "font.family-sans"
    },
    "body": {
      "size": 15,
      "line-height": 24,
      "weight": 400,
      "family": "font.family-sans"
    },
    "small": {
      "size": 13,
      "line-height": 20,
      "weight": 400,
      "family": "font.family-sans"
    },
    "caption": {
      "size": 12,
      "line-height": 18,
      "weight": 500,
      "family": "font.family-sans"
    },
    "mono": {
      "size": 13,
      "line-height": 20,
      "weight": 400,
      "family": "font.family-mono"
    }
  },
  "spacing": {
    "space-1": 4,
    "space-2": 8,
    "space-3": 12,
    "space-4": 16,
    "space-5": 20,
    "space-6": 24,
    "space-8": 32,
    "space-10": 40,
    "space-12": 48,
    "space-16": 64
  },
  "radius": {
    "radius-sm": 4,
    "radius-md": 8,
    "radius-lg": 12,
    "radius-xl": 16,
    "radius-pill": 999
  },
  "shadow": {
    "shadow-sm": "0 1px 2px rgba(26,27,30,0.06)",
    "shadow-md": "0 4px 12px rgba(26,27,30,0.08)",
    "shadow-lg": "0 12px 32px rgba(26,27,30,0.12)"
  },
  "motion": {
    "duration-fast": "120ms",
    "duration-normal": "240ms",
    "duration-slow": "400ms",
    "ease-out": "cubic-bezier(0.22, 1, 0.36, 1)",
    "ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)"
  }
}
