{
  "color": {
    "base": {
      "--nb-bg": "#FFFFFF",
      "--nb-bg-subtle": "#F7F8F9",
      "--nb-bg-hover": "#F0F4F9",
      "--nb-border": "#E1E3E6",
      "--nb-border-strong": "#C9CCD1"
    },
    "text": {
      "--nb-text": "#1F1F1F",
      "--nb-text-secondary": "#444746",
      "--nb-text-tertiary": "#5E5E5E"
    },
    "accent": {
      "--nb-accent": "#1A73E8",
      "--nb-accent-hover": "#1765CC",
      "--nb-accent-soft": "#E8F0FE"
    },
    "tint": {
      "--nb-tint-amber-bg": "#FEF0D3",
      "--nb-tint-amber-ink": "#8A5A00",
      "--nb-tint-violet-bg": "#EDE7FB",
      "--nb-tint-violet-ink": "#5B3E9B",
      "--nb-tint-green-bg": "#E4F3E8",
      "--nb-tint-green-ink": "#1E6B3A",
      "--nb-tint-teal-bg": "#DEF1F3",
      "--nb-tint-teal-ink": "#0F5F68",
      "--nb-tint-blue-bg": "#E3EEFC",
      "--nb-tint-blue-ink": "#174EA6"
    }
  },
  "font": {
    "family-sans": "\"Noto Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", system-ui, sans-serif"
  },
  "type": {
    "page-title": {
      "size": 24,
      "line-height": 1.3,
      "weight": 500,
      "color": "--nb-text",
      "size-clamp": "clamp(22px, 2vw, 28px)"
    },
    "section-title": {
      "size": 18,
      "line-height": 1.4,
      "weight": 500,
      "color": "--nb-text"
    },
    "card-title": {
      "size": 15,
      "line-height": 1.45,
      "weight": 500,
      "color": "--nb-text",
      "size-zh": 16
    },
    "body": {
      "size": 14,
      "line-height": 1.65,
      "weight": 400,
      "color": "--nb-text-secondary"
    },
    "meta": {
      "size": 12,
      "line-height": 1.4,
      "weight": 400,
      "color": "--nb-text-tertiary"
    },
    "micro-label": {
      "size": 11,
      "line-height": 1.3,
      "weight": 500,
      "color": "--nb-text-tertiary",
      "letter-spacing": "+0.02em"
    },
    "_zh_note": "中文正文比英文上调一档；正文行宽 32–40 汉字（65–75 字符），移动端 20–24 汉字"
  },
  "spacing": {
    "space-4": 4,
    "space-8": 8,
    "space-12": 12,
    "space-16": 16,
    "space-20": 20,
    "space-24": 24,
    "space-32": 32,
    "space-40": 40,
    "space-48": 48,
    "space-64": 64
  },
  "radius": {
    "--nb-radius-sm": 8,
    "--nb-radius-md": 12,
    "--nb-radius-lg": 16,
    "--nb-radius-pill": 999
  },
  "border-shadow": {
    "border-width": 1,
    "shadow-float": "0 1px 2px rgba(0,0,0,.04), 0 8px 24px rgba(0,0,0,.08)",
    "shadow-none": "none"
  },
  "motion": {
    "duration-fast": "150ms",
    "duration-normal": "180ms",
    "ease-out": "cubic-bezier(.2,0,0,1)",
    "duration-slow": "280ms",
    "ease-in": "ease-in",
    "duration-exit": "60–70% of duration-slow（原文：退出 60–70% 时长）",
    "stagger-step": "30–40ms",
    "stagger-max": 6,
    "reduced-motion": "prefers-reduced-motion: reduce 时过渡降为 0ms，保留最终状态"
  }
}
