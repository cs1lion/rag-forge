# 密钥与本地配置
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# SQLite 与运行产物（密钥库 / 生成视频 / 上传文件均不入库）
backend/storage/app.db
backend/storage/app.db-journal
backend/storage/app.db-wal
backend/storage/app.db-shm
backend/storage/videos/*.mp4
backend/storage/videos/*.tmp
!backend/storage/videos/.gitkeep
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep

# Node / 前端
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 系统垃圾
.DS_Store
__MACOSX/
*~

# 评估产物（Eval Agent 本地产物，不入库）
evals/reports/
evals/.cache/
