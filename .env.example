# LLM（OpenAI 兼容协议；Key 只经本文件注入，禁止硬编码、禁止提交）
# 注意：本文件是模板，请把真实 Key 填在 .env（.gitignore 已忽略），不要提交到仓库。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 后端服务
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# LLM 调用参数
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048

# 检索（本地混合：BM25 + TF-IDF，零外部 Embedding 依赖）
RETRIEVAL_TOP_K=5
RETRIEVAL_BM25_WEIGHT=0.6
RETRIEVAL_TFIDF_WEIGHT=0.4

# 视频队列（全局单并发，FIFO）
VIDEO_QUEUE_MAX_CONCURRENT=1
VIDEO_QUEUE_MAX_QUEUE=50

# 存储
STORAGE_UPLOADS_DIR=storage/uploads
STORAGE_VIDEOS_DIR=storage/videos
DATABASE_URL=sqlite:///storage/app.db

# 前端
FRONTEND_PORT=5173

# ── TTS（视频配音）──────────────────────────────────────────
# 二选一，缺省使用 edge-tts（免费、无需 Key）。
# 使用 OpenAI TTS 时填写以下两项：
TTS_PROVIDER=edge-tts
OPENAI_TTS_API_KEY=
OPENAI_TTS_VOICE=alloy
# edge-tts 声音（留空使用默认中文女声 zh-CN-XiaoxiaoNeural）
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
